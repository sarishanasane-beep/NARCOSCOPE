# ============================================================
# NARCOSCOPE — environment configuration
# Copy this file to `.env` and adjust as needed.
# ============================================================

# --- AI (OPTIONAL) -------------------------------------------
# NARCOSCOPE runs fully in deterministic (non-AI) mode when AI is disabled.
# The application MUST start and work with these values.
AI_ENABLED=false
AI_PROVIDER=
AI_API_KEY=

# --- Database ------------------------------------------------
# SQLite is the source of truth in Phase 1.
# Relative sqlite paths are resolved against the project root.
DATABASE_URL=sqlite:///./database/narcoscope.db

# --- Storage ------------------------------------------------
# Where original + extracted documents are stored.
UPLOAD_DIRECTORY=./data/documents
# Maximum upload size in bytes (default 25 MiB)
MAX_UPLOAD_SIZE=26214400

# --- Processing ---------------------------------------------
# Process (extract + create candidates) immediately after upload.
PROCESS_ON_UPLOAD=true

# --- Application ---------------------------------------------
DEBUG=false
LOG_LEVEL=INFO
